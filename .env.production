# Production Environment Variables
# Copy this to .env on your production server and fill with real values

# Docker Hub username (for pulling images)
DOCKER_USERNAME=yourusername

# Database credentials
DB_USER=pguser
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# JWT secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_STRING
REFRESH_TOKEN_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_STRING

# Optional: Domain name for SSL
# DOMAIN=api.yourdomain.com
