# Copy to .env and fill in real values for local development.

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/passwords_db

# REQUIRED. Must be >= 32 characters and not a known placeholder, or the app
# refuses to start. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_64_char_random_hex_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Token lifetimes (form: <int><s|m|h|d>).
ACCESS_TOKEN_EXPIRES_IN=35m
REFRESH_TOKEN_EXPIRES_IN=7d

# Brute-force protection.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Server.
PORT=4000
LOG_LEVEL=INFO
