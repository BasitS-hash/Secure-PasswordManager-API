# Production environment template.
# Copy to .env on your production host and replace every placeholder with a
# real value. NEVER commit the filled-in .env file.

# --- Database ---
# Full PostgreSQL connection string used by the application.
DATABASE_URL=postgresql://REPLACE_DB_USER:REPLACE_DB_PASSWORD@db-host:5432/passwords_db

# Individual parts (used by docker-compose if you build the URL from them).
DB_USER=REPLACE_DB_USER
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# --- JWT ---
# REQUIRED. Must be >= 32 chars and must NOT be a placeholder; the app refuses
# to start otherwise. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX

# Optional issuer/audience overrides (defaults are sensible).
# JWT_ISSUER=secure-password-manager-api
# JWT_AUDIENCE=secure-password-manager-clients

# --- Token lifetimes ---
ACCESS_TOKEN_EXPIRES_IN=35m
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Brute-force protection ---
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Server ---
PORT=4000
LOG_LEVEL=INFO

# --- Rate limiting (recommended for multi-worker/multi-instance prod) ---
# Use a shared Redis store so limits are enforced across all workers.
# RATELIMIT_STORAGE_URL=redis://redis-host:6379

# --- Container image (for docker-compose pulls) ---
DOCKER_USERNAME=REPLACE_DOCKERHUB_USERNAME
