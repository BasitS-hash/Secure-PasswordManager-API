{
  "openapi": "3.0.0",
  "info": {
    "title": "Secure Password Manager API",
    "description": "A zero-knowledge password manager API. Passwords are encrypted client-side with AES-256-GCM before being stored — the server never sees plaintext passwords.\n\n## How it works\n1. Register and get your `encryption_salt`\n2. Derive an AES key from your master password + salt (client-side)\n3. Encrypt your passwords before sending them\n4. Only you can decrypt them\n\n## Authentication\nUse the `/auth/login` endpoint to get a JWT `accessToken`, then include it as `Bearer <token>` in the `Authorization` header.",
    "version": "1.0.0",
    "contact": {
      "name": "Basit Sherazi",
      "url": "https://github.com/BasitS-hash/Secure-PasswordManager-API"
    }
  },
  "servers": [
    {
      "url": "https://secure-passwordmanager-api-production.up.railway.app",
      "description": "Production"
    },
    {
      "url": "http://localhost:4000",
      "description": "Local"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "Register, login, token refresh, logout" },
    { "name": "Entries", "description": "Store and retrieve encrypted password entries" },
    { "name": "Health", "description": "API status" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "description": "Returns the API status and current timestamp.",
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok",
                  "timestamp": "2026-04-04T16:50:35.016518"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user",
        "description": "Creates a new account. The password is hashed with Argon2id. An `encryption_salt` is generated and returned — use this client-side to derive your AES-256 encryption key.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "example": "basit" },
                  "password": { "type": "string", "example": "MySecurePass123!" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "example": {
                  "id": "3b9028ab-46af-4733-b78e-b08338fc4668",
                  "username": "basit"
                }
              }
            }
          },
          "400": { "description": "Missing username or password" },
          "500": { "description": "Registration failed (e.g. username already taken)" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login",
        "description": "Verifies credentials and returns a short-lived JWT `accessToken` (15 min), a long-lived `refreshToken` (7 days), and your `encryption_salt` for client-side key derivation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "example": "basit" },
                  "password": { "type": "string", "example": "MySecurePass123!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "example": {
                  "accessToken": "eyJhbGci...",
                  "refreshToken": "9099cf0f-c0cc-4ef6-8811-fe4c19ab4982",
                  "encryption_salt": "556938e01335199a6d81ff41af22b6ec"
                }
              }
            }
          },
          "400": { "description": "Missing credentials" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/token": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh access token",
        "description": "Exchange a valid `refreshToken` for a new `accessToken` without re-entering your password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string", "example": "9099cf0f-c0cc-4ef6-8811-fe4c19ab4982" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New access token issued",
            "content": {
              "application/json": {
                "example": { "accessToken": "eyJhbGci..." }
              }
            }
          },
          "400": { "description": "Missing refresh token" },
          "403": { "description": "Invalid or expired refresh token" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout",
        "description": "Invalidates the provided `refreshToken`, ending the session.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string", "example": "9099cf0f-c0cc-4ef6-8811-fe4c19ab4982" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged out",
            "content": {
              "application/json": {
                "example": { "ok": true }
              }
            }
          },
          "400": { "description": "Missing refresh token" }
        }
      }
    },
    "/entries/": {
      "post": {
        "tags": ["Entries"],
        "summary": "Store an encrypted password entry",
        "description": "Stores a client-side encrypted password. The server only stores the ciphertext — it never sees the plaintext password. Encrypt using AES-256-GCM with a key derived from your master password + `encryption_salt`.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "ciphertext", "iv", "tag"],
                "properties": {
                  "name": { "type": "string", "example": "Gmail" },
                  "ciphertext": { "type": "string", "description": "Base64-encoded AES-GCM ciphertext", "example": "dGVzdA==" },
                  "iv": { "type": "string", "description": "Base64-encoded 12-byte IV", "example": "dGVzdA==" },
                  "tag": { "type": "string", "description": "Base64-encoded 16-byte GCM auth tag", "example": "dGVzdA==" },
                  "meta": { "type": "string", "description": "Optional metadata (e.g. username, URL)", "example": "basit@gmail.com" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Entry stored",
            "content": {
              "application/json": {
                "example": { "ok": true }
              }
            }
          },
          "400": { "description": "Missing required fields" },
          "401": { "description": "Missing or invalid token" }
        }
      },
      "get": {
        "tags": ["Entries"],
        "summary": "List all password entries",
        "description": "Returns all encrypted password entries for the authenticated user. Decrypt client-side using your AES key.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of encrypted entries",
            "content": {
              "application/json": {
                "example": {
                  "entries": [
                    {
                      "id": "abc123",
                      "name": "Gmail",
                      "ciphertext": "dGVzdA==",
                      "iv": "dGVzdA==",
                      "tag": "dGVzdA==",
                      "meta": "basit@gmail.com",
                      "created_at": "2026-04-04T16:50:35"
                    }
                  ]
                }
              }
            }
          },
          "401": { "description": "Missing or invalid token" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Get a token from `/auth/login`, then paste it here."
      }
    }
  }
}
